<!-- Item repetido de nfse1:documentos (docDedRed, 1 a 1000). Montado uma vez por documento em NFSeGenerico::retDocumentosDocDedRed() e injetado em {@documentos} do DPS.xml. Ordem conforme TCDocDedRed do tiposComplexos_v1.01.xsd -->
<nfse1:docDedRed>
	<!-- IF CHOICE do documento: so um dos seis grupos pode ir nfse1:-->
	{@ifChNFSe}
	<nfse1:chNFSe>{@chNFSe}</nfse1:chNFSe>
	{@endifChNFSe}
	<!-- IF CHOICE nfse1:-->
	{@ifChNFe}
	<nfse1:chNFe>{@chNFe}</nfse1:chNFe>
	{@endifChNFe}
	<!-- IF CHOICE: outras NFS-e (padrao anterior de NFS-e) nfse1:-->
	{@ifNFSeMun}
	<nfse1:NFSeMun>
		<nfse1:cMunNFSeMun>{@cMunNFSeMun}</nfse1:cMunNFSeMun>
		<nfse1:nNFSeMun>{@nNFSeMun}</nfse1:nNFSeMun>
		<nfse1:cVerifNFSeMun>{@cVerifNFSeMun}</nfse1:cVerifNFSeMun>
	</nfse1:NFSeMun>
	{@endifNFSeMun}
	<!-- IF CHOICE: NF ou NFS (modelo nao eletronico) nfse1:-->
	{@ifNFNFS}
	<nfse1:NFNFS>
		<nfse1:nNFS>{@nNFS}</nfse1:nNFS>
		<nfse1:modNFS>{@modNFS}</nfse1:modNFS>
		<nfse1:serieNFS>{@serieNFS}</nfse1:serieNFS>
	</nfse1:NFNFS>
	{@endifNFNFS}
	<!-- IF CHOICE nfse1:-->
	{@ifNDocFisc}
	<nfse1:nDocFisc>{@nDocFisc}</nfse1:nDocFisc>
	{@endifNDocFisc}
	<!-- IF CHOICE nfse1:-->
	{@ifNDoc}
	<nfse1:nDoc>{@nDoc}</nfse1:nDoc>
	{@endifNDoc}
	<nfse1:tpDedRed>{@tpDedRed}</nfse1:tpDedRed>
	<!-- IF OPCIONAL nfse1:-->
	{@ifXDescOutDed}
	<nfse1:xDescOutDed>{@xDescOutDed}</nfse1:xDescOutDed>
	{@endifXDescOutDed}
	<nfse1:dtEmiDoc>{@dtEmiDoc}</nfse1:dtEmiDoc>
	<nfse1:vDedutivelRedutivel>{@vDedutivelRedutivel}</nfse1:vDedutivelRedutivel>
	<nfse1:vDeducaoReducao>{@vDeducaoReducao}</nfse1:vDeducaoReducao>
	<!-- IF OPCIONAL fornecedor (TCInfoPessoa) nfse1:-->
	{@ifFornec}
	<nfse1:fornec>
		<!-- IF CHOICE CNPJ/CPF/NIF/C NAO NIF FORNECEDOR nfse1:-->
		{@ifCNPJFornec}
		<nfse1:CNPJ>{@CNPJFornec}</nfse1:CNPJ>
		{@endifCNPJFornec}
		<!-- IF CHOICE nfse1:-->
		{@ifCPFFornec}
		<nfse1:CPF>{@CPFFornec}</nfse1:CPF>
		{@endifCPFFornec}
		<!-- IF CHOICE nfse1:-->
		{@ifNIFFornec}
		<nfse1:NIF>{@NIFFornec}</nfse1:NIF>
		{@endifNIFFornec}
		<!-- IF CHOICE nfse1:-->
		{@ifCNaoNIFFornec}
		<nfse1:cNaoNIF>{@cNaoNIFFornec}</nfse1:cNaoNIF>
		{@endifCNaoNIFFornec}
		<!-- IF OPCIONAL nfse1:-->
		{@ifCAEPFFornec}
		<nfse1:CAEPF>{@CAEPFFornec}</nfse1:CAEPF>
		{@endifCAEPFFornec}
		<!-- IF OPCIONAL nfse1:-->
		{@ifIMFornec}
		<nfse1:IM>{@IMFornec}</nfse1:IM>
		{@endifIMFornec}
		<nfse1:xNome>{@xNomeFornec}</nfse1:xNome>
		<!-- IF OPCIONAL nfse1:-->
		{@ifEndFornec}
		<nfse1:end>
			<!-- IF CHOICE nfse1:-->
			{@ifEndNacFornec}
			<nfse1:endNac>
				<nfse1:cMun>{@cMunFornec}</nfse1:cMun>
				<nfse1:CEP>{@CEPFornec}</nfse1:CEP>
			</nfse1:endNac>
			{@endifEndNacFornec}
			<!-- IF CHOICE nfse1:-->
			{@ifEndExtFornec}
			<nfse1:endExt>
				<nfse1:cPais>{@cPaisFornec}</nfse1:cPais>
				<nfse1:cEndPost>{@cEndPostFornec}</nfse1:cEndPost>
				<nfse1:xCidade>{@xCidadeFornec}</nfse1:xCidade>
				<nfse1:xEstProvReg>{@xEstProvRegFornec}</nfse1:xEstProvReg>
			</nfse1:endExt>
			{@endifEndExtFornec}
			<nfse1:xLgr>{@xLgrFornec}</nfse1:xLgr>
			<nfse1:nro>{@nroFornec}</nfse1:nro>
			<!-- IF OPCIONAL nfse1:-->
			{@ifXCplFornec}
			<nfse1:xCpl>{@xCplFornec}</nfse1:xCpl>
			{@endifXCplFornec}
			<nfse1:xBairro>{@xBairroFornec}</nfse1:xBairro>
		</nfse1:end>
		{@endifEndFornec}
		<!-- IF OPCIONAL nfse1:-->
		{@ifFoneFornec}
		<nfse1:fone>{@foneFornec}</nfse1:fone>
		{@endifFoneFornec}
		<!-- IF OPCIONAL nfse1:-->
		{@ifEmailFornec}
		<nfse1:email>{@emailFornec}</nfse1:email>
		{@endifEmailFornec}
	</nfse1:fornec>
	{@endifFornec}
</nfse1:docDedRed>
