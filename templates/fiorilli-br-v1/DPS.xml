<?xml version="1.0" encoding="utf-8"?>
<DPS xmlns="http://www.sped.fazenda.gov.br/nfse" versao="{@versao}">
	<!-- Prefixos do root = os mesmos do Soap.xml: se o envelope acrescentar namespace ao escopo, a C14N inclusiva muda infDPS/SignedInfo e a assinatura cai (E172) -->
	<infDPS Id="{@IdDPS}">
		<tpAmb>{@tpAmb}</tpAmb>
		<dhEmi>{@dhEmi}</dhEmi>
		<verAplic>{@verAplic}</verAplic>
		<serie>{@serie}</serie>
		<nDPS>{@nDPS}</nDPS>
		<dCompet>{@dCompet}</dCompet>
		<tpEmit>{@tpEmit}</tpEmit>
		{@ifCMotivoEmisTI}
		<cMotivoEmisTI>{@cMotivoEmisTI}</cMotivoEmisTI>
		{@endifCMotivoEmisTI}
		{@ifChNFSeRej}
		<chNFSeRej>{@chNFSeRej}</chNFSeRej>
		{@endifChNFSeRej}
		<cLocEmi>{@cLocEmi}</cLocEmi>
		{@ifSubst}
		<subst>
			<chSubstda>{@chSubstda}</chSubstda>
			<cMotivo>{@cMotivo}</cMotivo>
			{@ifXMotivo}
			<xMotivo>{@xMotivo}</xMotivo>
			{@endifXMotivo}
		</subst>
		{@endifSubst}
		<prest>
			<!-- IF CHOICE CNPJ/CPF/NIF/C NÃO NIF TOMADOR -->
			{@ifCNPJPrestador}
			<CNPJ>{@CNPJPrestador}</CNPJ>
			{@endifCNPJPrestador}
			
			{@ifCPFPrestador}
			<CPF>{@CPFPrestador}</CPF>
			{@endifCPFPrestador}
			
			{@ifNIFPrestador}
			<NIF>{@NIFPrestador}</NIF>
			{@endifNIFPrestador}
			
			{@ifCNaoNIFPrestador}
			<cNaoNIF>{@cNaoNIFPrestador}</cNaoNIF>
			{@endifCNaoNIFPrestador}
			<!-- IF OPCIONAL CAEPF DPS PRESTADOR -->
			{@ifCAEPFPrestador}
			<CAEPF>{@CAEPFPrestador}</CAEPF>
			{@endifCAEPFPrestador}
			{@ifIMPrestador}
			<IM>{@IMPrestador}</IM>
			{@endifIMPrestador}
			{@ifXNomePrestador}
			
			<!-- A razaão social do prestador não pode ser informado caso ele seja o emitente, tpEmit = 1
			E0128 Se o emitente da DPS for o prestador de serviço (tpEmit = 1), então o nome ou razão social não deve ser informado.
			-->
			<!--xNome>{@xNomePrestador}</xNome-->

			{@endifXNomePrestador}
			
			{@ifEndPrestador}
			
			<!-- O endereço do prestador não pode ser informado caso ele seja o emitente, tpEmit = 1
			E0128 O endereço do prestador do serviço não deve ser informado na DPS quando o próprio prestador for o emitente da DPS 
			-->
			<!--end>
				{@ifEndNacPrestador}
				<endNac>
					<cMun>{@cMunPrestador}</cMun>
					<CEP>{@CEPPrestador}</CEP>
				</endNac>
				{@endifEndNacPrestador}
				{@ifEndExtPrestador}
				<endExt>
					<cPais>{@cPaisPrestador}</cPais>
					<cEndPost>{@cEndPostPrestador}</cEndPost>
					<xCidade>{@xCidadePrestador}</xCidade>
					<xEstProvReg>{@xEstProvRegPrestador}</xEstProvReg>
				</endExt>
				{@endifEndExtPrestador}
				<xLgr>{@xLgrPrestador}</xLgr>
				<nro>{@nroPrestador}</nro>
				{@ifXCplPrestador}
				<xCpl>{@xCplPrestador}</xCpl>
				{@endifXCplPrestador}
				<xBairro>{@xBairroPrestador}</xBairro>
			</end-->
			{@endifEndPrestador}

			{@ifFonePrestador}
			<fone>{@fonePrestador}</fone>
			{@endifFonePrestador}
			{@ifEmailPrestador}
			<email>{@emailPrestador}</email>
			{@endifEmailPrestador}
			<regTrib>
				<opSimpNac>{@opSimpNac}</opSimpNac>
				{@ifRegApTribSN}
				<regApTribSN>{@regApTribSN}</regApTribSN>
				{@endifRegApTribSN}
				<regEspTrib>{@regEspTrib}</regEspTrib>
			</regTrib>
		</prest>
		{@ifToma}
		<toma>
			<!-- IF CHOICE CNPJ/CPF/NIF/C NÃO NIF TOMADOR -->
			{@ifCNPJTomador}
			<CNPJ>{@CNPJTomador}</CNPJ>
			{@endifCNPJTomador}
			
			{@ifCPFTomador}
			<CPF>{@CPFTomador}</CPF>
			{@endifCPFTomador}
			
			{@ifNIFTomador}
			<NIF>{@NIFTomador}</NIF>
			{@endifNIFTomador}
			
			{@ifCNaoNIFTomador}
			<cNaoNIF>{@cNaoNIFTomador}</cNaoNIF>
			{@endifCNaoNIFTomador}
			<!-- IF OPCIONAL CAEPF DPS TOMADOR -->
			{@ifCAEPFTomador}
			<CAEPF>{@CAEPFTomador}</CAEPF>
			{@endifCAEPFTomador}
			<!-- IF OPCIONAL IM DPS TOMADOR -->
			{@ifIMTomador}
			<IM>{@IMTomador}</IM>
			{@endifIMTomador}
			<xNome>{@xNomeTomador}</xNome>
			<!-- IF OPCIONAL END DPS TOMADOR -->
			{@ifEndTomador}
			<end>
				
				{@ifEndNacTomador}
				<endNac>
					<cMun>{@cMunTomador}</cMun>
					<CEP>{@CEPTomador}</CEP>
				</endNac>
				{@endifEndNacTomador}
				
				{@ifEndExtTomador}
				<endExt>
					<cPais>{@cPaisTomador}</cPais>
					<cEndPost>{@cEndPostTomador}</cEndPost>
					<xCidade>{@xCidadeTomador}</xCidade>
					<xEstProvReg>{@xEstProvRegTomador}</xEstProvReg>
				</endExt>
				{@endifEndExtTomador}
				<xLgr>{@xLgrTomador}</xLgr>
				<nro>{@nroTomador}</nro>
				{@ifXCplTomador}
				<xCpl>{@xCplTomador}</xCpl>
				{@endifXCplTomador}
				<xBairro>{@xBairroTomador}</xBairro>
			</end>
			{@endifEndTomador}
			{@ifFoneTomador}
			<fone>{@foneTomador}</fone>
			{@endifFoneTomador}
			{@ifEmailTomador}
			<email>{@emailTomador}</email>
			{@endifEmailTomador}
		</toma>
		{@endifToma}
		{@ifInterm}
		<interm>
			<!-- IF CHOICE CNPJ/CPF/NIF/C NÃO NIF INTERMEDIÁRIO -->
			{@ifCNPJInterm}
			<CNPJ>{@CNPJInterm}</CNPJ>
			{@endifCNPJInterm}
			
			{@ifCPFInterm}
			<CPF>{@CPFInterm}</CPF>
			{@endifCPFInterm}
			
			{@ifNIFInterm}
			<NIF>{@NIFInterm}</NIF>
			{@endifNIFInterm}
			
			{@ifCNaoNIFInterm}
			<cNaoNIF>{@cNaoNIFInterm}</cNaoNIF>
			{@endifCNaoNIFInterm}
			<!-- IF OPCIONAL CAEPF INTERMEDIÁRIO -->
			{@ifCAEPFInterm}
			<CAEPF>{@CAEPFInterm}</CAEPF>
			{@endifCAEPFInterm}
			<!-- IF OPCIONAL IM INTERMEDIÁRIO -->
			{@ifIMInterm}
			<IM>{@IMInterm}</IM>
			{@endifIMInterm}
			<xNome>{@xNomeInterm}</xNome>
			<!-- IF OPCIONAL END INTERMEDIÁRIO -->
			{@ifEndInterm}
			<end>
				
				{@ifEndNacInterm}
				<endNac>
					<cMun>{@cMunInterm}</cMun>
					<CEP>{@CEPInterm}</CEP>
				</endNac>
				{@endifEndNacInterm}
				
				{@ifEndExtInterm}
				<endExt>
					<cPais>{@cPaisInterm}</cPais>
					<cEndPost>{@cEndPostInterm}</cEndPost>
					<xCidade>{@xCidadeInterm}</xCidade>
					<xEstProvReg>{@xEstProvRegInterm}</xEstProvReg>
				</endExt>
				{@endifEndExtInterm}
				<xLgr>{@xLgrInterm}</xLgr>
				<nro>{@nroInterm}</nro>
				{@ifXCplInterm}
				<xCpl>{@xCplInterm}</xCpl>
				{@endifXCplInterm}
				<xBairro>{@xBairroInterm}</xBairro>
			</end>
			{@endifEndInterm}
			{@ifFoneInterm}
			<fone>{@foneInterm}</fone>
			{@endifFoneInterm}
			{@ifEmailInterm}
			<email>{@emailInterm}</email>
			{@endifEmailInterm}
		</interm>
		{@endifInterm}
		<serv>
			<locPrest>
				
				{@ifCLocPrestacao}
				<cLocPrestacao>{@cLocPrestacao}</cLocPrestacao>
				{@endifCLocPrestacao}
				
				{@ifCPaisPrestacao}
				<cPaisPrestacao>{@cPaisPrestacao}</cPaisPrestacao>
				{@endifCPaisPrestacao}
			</locPrest>
			<cServ>
				<cTribNac>{@cTribNac}</cTribNac>
				<!-- IF OPCIONAL: sem o guard, o ERP sem esse dado geraria a tag vazia e o valor vazio nao passa no pattern do XSD -->
				{@ifCTribMun}
				<cTribMun>{@cTribMun}</cTribMun>
				{@endifCTribMun}
				<xDescServ>{@xDescServ}</xDescServ>
				{@ifCNBS}
				<cNBS>{@cNBS}</cNBS>
				{@endifCNBS}
				{@ifCIntContrib}
				<cIntContrib>{@cIntContrib}</cIntContrib>
				{@endifCIntContrib}
			</cServ>
			{@ifComExt}
			<comExt>
				<mdPrestacao>{@mdPrestacao}</mdPrestacao>
				<vincPrest>{@vincPrest}</vincPrest>
				<tpMoeda>{@tpMoeda}</tpMoeda>
				<vServMoeda>{@vServMoeda}</vServMoeda>
				<mecAFComexP>{@mecAFComexP}</mecAFComexP>
				<mecAFComexT>{@mecAFComexT}</mecAFComexT>
				<movTempBens>{@movTempBens}</movTempBens>
				{@ifNDI}
				<nDI>{@nDI}</nDI>
				{@endifNDI}
				{@ifNRE}
				<nRE>{@nRE}</nRE>
				{@endifNRE}
				<mdic>{@mdic}</mdic>
			</comExt>
			{@endifComExt}
			{@ifObra}
			<obra>
				{@ifInscImobFiscObra}
				<inscImobFisc>{@inscImobFiscObra}</inscImobFisc>
				{@endifInscImobFiscObra}
				
				{@ifCObra}
				<cObra>{@cObra}</cObra>
				{@endifCObra}
				
				{@ifCCIBObra}
				<cCIB>{@cCIBObra}</cCIB>
				{@endifCCIBObra}
				
				{@ifEndObra}
				<end>
					
					{@ifCEPObra}
					<CEP>{@CEPObra}</CEP>
					{@endifCEPObra}
					
					{@ifEndExtObra}
					<endExt>
						<cEndPost>{@cEndPostObra}</cEndPost>
						<xCidade>{@xCidadeObra}</xCidade>
						<xEstProvReg>{@xEstProvRegObra}</xEstProvReg>
					</endExt>
					{@endifEndExtObra}
					<xLgr>{@xLgrObra}</xLgr>
					<nro>{@nroObra}</nro>
					{@ifXCplObra}
					<xCpl>{@xCplObra}</xCpl>
					{@endifXCplObra}
					<xBairro>{@xBairroObra}</xBairro>
				</end>
				{@endifEndObra}
			</obra>
			{@endifObra}
			{@ifAtvEvento}
			<atvEvento>
				<xNome>{@xNomeAtvEvento}</xNome>
				<dtIni>{@dtIniAtvEvento}</dtIni>
				<dtFim>{@dtFimAtvEvento}</dtFim>
				
				{@ifIdAtvEv}
				<idAtvEv>{@idAtvEv}</idAtvEv>
				{@endifIdAtvEv}
				
				{@ifEndAtvEvento}
				<end>
					
					{@ifCEPAtvEvento}
					<CEP>{@CEPAtvEvento}</CEP>
					{@endifCEPAtvEvento}
					
					{@ifEndExtAtvEvento}
					<endExt>
						<cEndPost>{@cEndPostAtvEvento}</cEndPost>
						<xCidade>{@xCidadeAtvEvento}</xCidade>
						<xEstProvReg>{@xEstProvRegAtvEvento}</xEstProvReg>
					</endExt>
					{@endifEndExtAtvEvento}
					<xLgr>{@xLgrAtvEvento}</xLgr>
					<nro>{@nroAtvEvento}</nro>
					{@ifXCplAtvEvento}
					<xCpl>{@xCplAtvEvento}</xCpl>
					{@endifXCplAtvEvento}
					<xBairro>{@xBairroAtvEvento}</xBairro>
				</end>
				{@endifEndAtvEvento}
			</atvEvento>
			{@endifAtvEvento}
			{@ifInfoCompl}
			<infoCompl>
				{@ifIdDocTec}
				<idDocTec>{@idDocTec}</idDocTec>
				{@endifIdDocTec}
				{@ifDocRef}
				<docRef>{@docRef}</docRef>
				{@endifDocRef}
				{@ifXPed}
				<xPed>{@xPed}</xPed>
				{@endifXPed}
				{@ifGItemPed}
				<gItemPed>
					{@gItemPed}
				</gItemPed>
				{@endifGItemPed}
				{@ifXInfComp}
				<xInfComp>{@xInfComp}</xInfComp>
				{@endifXInfComp}
			</infoCompl>
			{@endifInfoCompl}
		</serv>
		<valores>
			<vServPrest>
				{@ifVReceb}
				<vReceb>{@vReceb}</vReceb>
				{@endifVReceb}
				<vServ>{@vServ}</vServ>
			</vServPrest>
			{@ifVDescCondIncond}
			<vDescCondIncond>
				{@ifVDescIncond}
				<vDescIncond>{@vDescIncond}</vDescIncond>
				{@endifVDescIncond}
				{@ifVDescCond}
				<vDescCond>{@vDescCond}</vDescCond>
				{@endifVDescCond}
			</vDescCondIncond>
			{@endifVDescCondIncond}
			{@ifVDedRed}
			<vDedRed>
				
				{@ifPDR}
				<pDR>{@pDR}</pDR>
				{@endifPDR}
				
				{@ifVDR}
				<vDR>{@vDR}</vDR>
				{@endifVDR}
				
				{@ifDocumentos}
				<documentos>
					{@documentos}
				</documentos>
				{@endifDocumentos}
			</vDedRed>
			{@endifVDedRed}
			<trib>
				<tribMun>
					<tribISSQN>{@tribISSQN}</tribISSQN>
					{@ifCPaisResult}
					<cPaisResult>{@cPaisResult}</cPaisResult>
					{@endifCPaisResult}
					{@ifTpImunidade}
					<tpImunidade>{@tpImunidade}</tpImunidade>
					{@endifTpImunidade}
					{@ifExigSusp}
					<exigSusp>
						<tpSusp>{@tpSusp}</tpSusp>
						<nProcesso>{@nProcesso}</nProcesso>
					</exigSusp>
					{@endifExigSusp}
					{@ifBM}
					<BM>
						<nBM>{@nBM}</nBM>
						
						{@ifVRedBCBM}
						<vRedBCBM>{@vRedBCBM}</vRedBCBM>
						{@endifVRedBCBM}
						
						{@ifPRedBCBM}
						<pRedBCBM>{@pRedBCBM}</pRedBCBM>
						{@endifPRedBCBM}
					</BM>
					{@endifBM}
					<tpRetISSQN>{@tpRetISSQN}</tpRetISSQN>
					{@ifPAliqISSQN}
					<pAliq>{@pAliq}</pAliq>
					{@endifPAliqISSQN}
				</tribMun>
				{@ifTribFed}
				<tribFed>
					{@ifPiscofins}
					<piscofins>
						<CST>{@CST}</CST>
						{@ifVBCPisCofins}
						<vBCPisCofins>{@vBCPisCofins}</vBCPisCofins>
						{@endifVBCPisCofins}
						{@ifPAliqPis}
						<pAliqPis>{@pAliqPis}</pAliqPis>
						{@endifPAliqPis}
						{@ifPAliqCofins}
						<pAliqCofins>{@pAliqCofins}</pAliqCofins>
						{@endifPAliqCofins}
						{@ifVPis}
						<vPis>{@vPis}</vPis>
						{@endifVPis}
						{@ifVCofins}
						<vCofins>{@vCofins}</vCofins>
						{@endifVCofins}
						{@ifTpRetPisCofins}
						<tpRetPisCofins>{@tpRetPisCofins}</tpRetPisCofins>
						{@endifTpRetPisCofins}
					</piscofins>
					{@endifPiscofins}
					{@ifVRetCP}
					<vRetCP>{@vRetCP}</vRetCP>
					{@endifVRetCP}
					{@ifVRetIRRF}
					<vRetIRRF>{@vRetIRRF}</vRetIRRF>
					{@endifVRetIRRF}
					{@ifVRetCSLL}
					<vRetCSLL>{@vRetCSLL}</vRetCSLL>
					{@endifVRetCSLL}
				</tribFed>
				{@endifTribFed}
				<totTrib>
					
					{@ifVTotTrib}
					<vTotTrib>
						<vTotTribFed>{@vTotTribFed}</vTotTribFed>
						<vTotTribEst>{@vTotTribEst}</vTotTribEst>
						<vTotTribMun>{@vTotTribMun}</vTotTribMun>
					</vTotTrib>
					{@endifVTotTrib}
					
					{@ifPTotTrib}
					<pTotTrib>
						<pTotTribFed>{@pTotTribFed}</pTotTribFed>
						<pTotTribEst>{@pTotTribEst}</pTotTribEst>
						<pTotTribMun>{@pTotTribMun}</pTotTribMun>
					</pTotTrib>
					{@endifPTotTrib}
					
					{@ifIndTotTrib}
					<indTotTrib>{@indTotTrib}</indTotTrib>
					{@endifIndTotTrib}
					
					{@ifPTotTribSN}
					<pTotTribSN>{@pTotTribSN}</pTotTribSN>
					{@endifPTotTribSN}
				</totTrib>
			</trib>
		</valores>
		{@ifIBSCBS}
		<IBSCBS>
			<finNFSe>{@finNFSe}</finNFSe>
			{@ifIndFinal}
			<indFinal>{@indFinal}</indFinal>
			{@endifIndFinal}
			<cIndOp>{@cIndOp}</cIndOp>
			{@ifTpOper}
			<tpOper>{@tpOper}</tpOper>
			{@endifTpOper}
			<!-- IF OPCIONAL: o item que repete e o refNFSe (ate 99), montado pelo template parcial 'refNfse' -->
			{@ifGRefNFSe}
			<gRefNFSe>
				{@gRefNFSe}
			</gRefNFSe>
			{@endifGRefNFSe}
			{@ifTpEnteGov}
			<tpEnteGov>{@tpEnteGov}</tpEnteGov>
			{@endifTpEnteGov}
			<indDest>{@indDest}</indDest>
			<!-- IF OPCIONAL destinatario do servico -->
			{@ifDest}
			<dest>
				<!-- IF CHOICE CNPJ/CPF/NIF/C NAO NIF DESTINATARIO -->
				{@ifCNPJDest}
				<CNPJ>{@CNPJDest}</CNPJ>
				{@endifCNPJDest}
				
				{@ifCPFDest}
				<CPF>{@CPFDest}</CPF>
				{@endifCPFDest}
				
				{@ifNIFDest}
				<NIF>{@NIFDest}</NIF>
				{@endifNIFDest}
				
				{@ifCNaoNIFDest}
				<cNaoNIF>{@cNaoNIFDest}</cNaoNIF>
				{@endifCNaoNIFDest}
				<xNome>{@xNomeDest}</xNome>
				{@ifEndDest}
				<end>
					
					{@ifEndNacDest}
					<endNac>
						<cMun>{@cMunDest}</cMun>
						<CEP>{@CEPDest}</CEP>
					</endNac>
					{@endifEndNacDest}
					
					{@ifEndExtDest}
					<endExt>
						<cPais>{@cPaisDest}</cPais>
						<cEndPost>{@cEndPostDest}</cEndPost>
						<xCidade>{@xCidadeDest}</xCidade>
						<xEstProvReg>{@xEstProvRegDest}</xEstProvReg>
					</endExt>
					{@endifEndExtDest}
					<xLgr>{@xLgrDest}</xLgr>
					<nro>{@nroDest}</nro>
					{@ifXCplDest}
					<xCpl>{@xCplDest}</xCpl>
					{@endifXCplDest}
					<xBairro>{@xBairroDest}</xBairro>
				</end>
				{@endifEndDest}
				{@ifFoneDest}
				<fone>{@foneDest}</fone>
				{@endifFoneDest}
				{@ifEmailDest}
				<email>{@emailDest}</email>
				{@endifEmailDest}
			</dest>
			{@endifDest}
			<!-- IF OPCIONAL imovel -->
			{@ifImovel}
			<imovel>
				{@ifInscImobFiscImovel}
				<inscImobFisc>{@inscImobFiscImovel}</inscImobFisc>
				{@endifInscImobFiscImovel}
				<!-- IF CHOICE cCIB/end -->
				{@ifCCIBImovel}
				<cCIB>{@cCIBImovel}</cCIB>
				{@endifCCIBImovel}
				
				{@ifEndImovel}
				<end>
					
					{@ifCEPImovel}
					<CEP>{@CEPImovel}</CEP>
					{@endifCEPImovel}
					
					{@ifEndExtImovel}
					<endExt>
						<cEndPost>{@cEndPostImovel}</cEndPost>
						<xCidade>{@xCidadeImovel}</xCidade>
						<xEstProvReg>{@xEstProvRegImovel}</xEstProvReg>
					</endExt>
					{@endifEndExtImovel}
					<xLgr>{@xLgrImovel}</xLgr>
					<nro>{@nroImovel}</nro>
					{@ifXCplImovel}
					<xCpl>{@xCplImovel}</xCpl>
					{@endifXCplImovel}
					<xBairro>{@xBairroImovel}</xBairro>
				</end>
				{@endifEndImovel}
