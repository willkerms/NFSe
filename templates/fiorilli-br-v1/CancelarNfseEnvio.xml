<?xml version="1.0" encoding="utf-8"?>
<nfse:CancelarNFSeEnvio xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:nfse="http://www.fiorilli.com.br/nfse-nacional" xmlns:nfse1="http://www.sped.fazenda.gov.br/nfse" xmlns:xd="http://www.w3.org/2000/09/xmldsig#">
	<!-- NAO REMOVER nenhum xmlns do root: diferente do RecepcionarDpsEnvio.xml, aqui o conteudo assinado (infPedReg) nao declara prefixo proprio, quem define o escopo dele e este elemento. Os 4 prefixos tem que ser os mesmos do Soap.xml, senao o envelope acrescenta namespace ao escopo, muda a C14N de infPedReg/SignedInfo e derruba a assinatura (E172) -->
	<nfse:IM>{@IMPrestador}</nfse:IM>
	<nfse:pedRegEvento versao="1.01">
		<nfse1:infPedReg Id="{@IdPedidoRegistroEvento}">
			<nfse1:tpAmb>{@tpAmb}</nfse1:tpAmb>
			<nfse1:verAplic>{@verAplic}</nfse1:verAplic>
			<nfse1:dhEvento>{@dhEvento}</nfse1:dhEvento>
			<!-- IF CHOICE CNPJ/CPF do autor do evento nfse1:-->
			{@ifCNPJAutor}
			<nfse1:CNPJAutor>{@CNPJAutor}</nfse1:CNPJAutor>
			{@endifCNPJAutor}
			<!-- IF CHOICE nfse1:-->
			{@ifCPFAutor}
			<nfse1:CPFAutor>{@CPFAutor}</nfse1:CPFAutor>
			{@endifCPFAutor}
			<nfse1:chNFSe>{@chNFSe}</nfse1:chNFSe>
			<!-- IF CHOICE evento: 101101 = cancelamento a pedido do prestador nfse1:-->
			{@ifE101101}
			<nfse1:e101101>
				<nfse1:xDesc>Cancelamento de NFS-e</nfse1:xDesc>
				<nfse1:cMotivo>{@cMotivo}</nfse1:cMotivo>
				<!-- IF OPCIONAL nfse1:-->
				{@ifXMotivo}
				<nfse1:xMotivo>{@xMotivo}</nfse1:xMotivo>
				{@endifXMotivo}
			</nfse1:e101101>
			{@endifE101101}
		</nfse1:infPedReg>
		<!--<xd:Signature>string</xd:Signature>-->
	</nfse:pedRegEvento>
</nfse:CancelarNFSeEnvio>
